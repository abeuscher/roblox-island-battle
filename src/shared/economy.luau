--!strict
-- economy.luau — Coin and Charge accrual. Pure Luau.
--
-- Coin: base rate plus grove income, per income tick. Groves are the
-- bombable/rebuildable part of the economy.
-- Charge: flat regen, capped, NOT tied to structures — the anti-snowball
-- measure from SPEC §4. Losing a base costs you the match, never your
-- ability to keep playing it.

-- Dual-target module loading: under Rojo/Roblox `script` exists and modules
-- are instances; under Lune `script` is nil and modules are files. Keeping
-- this shim here is what lets the identical pure core run in both places
-- with no build step (see DECISIONS.md).
local function import(name: string): any
	if script ~= nil then
		return require((script :: any).Parent[name])
	end
	return require("./" .. name)
end

local State = import("state")
local Weapons = import("weapons")

local Economy = {}

-- Coin generated by one completed, alive grove per income tick.
local function groveIncome(config: any, grove: State.Structure): number
	return Weapons.getStat(config, "grove", grove.tier, "income") or config.GROVE_INCOME
end

function Economy.tick(state: State.MatchState, dt: number, events: { State.Event })
	local config = state.config
	for _, player in state.players do
		-- Coin
		player.coinAcc += dt
		while player.coinAcc >= config.COIN_TICK_SECONDS do
			player.coinAcc -= config.COIN_TICK_SECONDS
			local income = config.COIN_BASE_RATE
			for _, s in player.structures do
				if s.alive and s.kind == "grove" and s.buildRemaining <= 0 then
					income += groveIncome(config, s)
				end
			end
			player.coin += income
			player.stats.coinEarned += income
		end

		-- Charge (flat, capped)
		player.chargeAcc += dt
		while player.chargeAcc >= config.CHARGE_REGEN_SECONDS do
			player.chargeAcc -= config.CHARGE_REGEN_SECONDS
			if player.charge < config.CHARGE_CAP then
				player.charge += 1
			end
		end
	end
end

-- Spend helpers used by rules command handling. Return false if unaffordable.
function Economy.spendCoin(player: State.Player, amount: number): boolean
	if player.coin < amount then
		return false
	end
	player.coin -= amount
	player.stats.coinSpent += amount
	return true
end

function Economy.spendCharge(player: State.Player, amount: number): boolean
	if player.charge < amount then
		return false
	end
	player.charge -= amount
	return true
end

return Economy
